# ============================================================================
# API del Sistema de Diagnóstico Organizacional LinkTIC
# Copie este archivo como .env y complete los valores.
# NINGUNA de estas variables lleva el prefijo NEXT_PUBLIC_: todo lo NEXT_PUBLIC_
# queda visible en el bundle del navegador.
# ============================================================================

NODE_ENV=development
PORT=3001

# Orígenes autorizados, separados por coma. NO use '*': la sesión del admin viaja
# en cookie y los navegadores rechazan credenciales contra un comodín.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de datos (Supabase)
# ---------------------------------------------------------------------------
# Runtime de la app. POOLER en modo TRANSACCIÓN: puerto 6543 y ?pgbouncer=true.
# Es el que soporta las muchas conexiones efímeras de las funciones serverless; una
# conexión directa agota el límite de Postgres con varios arranques en frío a la vez.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Solo para el CLI de Prisma (migrate, seed). POOLER en modo SESIÓN: puerto 5432, SIN
# pgbouncer. Las migraciones toman locks a nivel de sesión que el modo transacción no
# conserva entre sentencias: con el 6543, `prisma migrate deploy` se queda colgado
# indefinidamente y sin mensaje de error.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# LA REGIÓN DEBE SER LA DE SU PROYECTO. Si no coincide, el pooler responde
# "tenant/user postgres.<ref> not found", que parece un problema de credenciales pero es
# de región. Copie la cadena exacta del panel de Supabase → Project Settings → Database →
# Connection string; no la escriba a mano.

# ---------------------------------------------------------------------------
# Acceso al panel de administración
# ---------------------------------------------------------------------------
# Token inicial solicitado por LinkTIC. ADVERTENCIA: es un valor predecible, y un
# token compartido no da trazabilidad por persona ni permite revocar el acceso de
# alguien sin afectar a los demás. Reemplácelo por una cadena aleatoria larga
# antes de exponer datos reales del diagnóstico.
ADMIN_ACCESS_TOKEN=Admin123!@

# Cadena aleatoria de 64+ caracteres, DISTINTA de HASH_SALT.
# Generar con: openssl rand -base64 48
JWT_SECRET=

JWT_EXPIRES_IN=8h
COOKIE_NAME=linktic_admin_session

# Solo en producción y solo si el back vive en un subdominio del mismo dominio
# del front (p. ej. .linktic.com). Déjelo vacío en local.
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Privacidad y seguridad
# ---------------------------------------------------------------------------
# Sal para hashear IPs y user agents. Nunca se persisten en claro.
# Cadena aleatoria, DISTINTA de JWT_SECRET.
HASH_SALT=

# Mínimo de respuestas para publicar un corte. Por debajo de este número el panel
# muestra "datos insuficientes" en vez del dato: con dos o tres personas en un
# área, un promedio permite deducir quién dijo qué.
MIN_COHORT_SIZE=4

# Intentos de login fallidos permitidos por IP dentro de la ventana.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Comportamiento de la encuesta
# ---------------------------------------------------------------------------
# false = anónima (nombre y cargo opcionales). Ponerlo en true los vuelve
# obligatorios; sube la trazabilidad y baja la franqueza de las respuestas.
SURVEY_REQUIRE_IDENTITY=false

# Reservado: pedir los motivos del NPS por cada área en vez de una sola vez.
NPS_MOTIVOS_POR_AREA=false

# Máximo de áreas que un encuestado puede declarar en la pregunta 1.2. Es el
# límite que sostiene los 15 minutos de diligenciamiento.
MAX_AREAS_INTERACCION=5
